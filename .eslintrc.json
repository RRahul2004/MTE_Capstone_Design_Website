{
  "extends": ["next/core-web-vitals"],
  "rules": {
    "no-unused-vars": [
      "warn",
      {
        "args": "none",
        "varsIgnorePattern": "^_",
        "ignoreRestSiblings": true
      }
    ],
    "react-hooks/exhaustive-deps": "warn"
  },
  "ignorePatterns": [".next/", "node_modules/", ".test-build/", "next-env.d.ts"]
}
